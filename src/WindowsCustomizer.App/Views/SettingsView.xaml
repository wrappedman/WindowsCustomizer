<UserControl x:Class="WindowsCustomizer.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />

        <!-- Projects -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="PROJECTS" Style="{StaticResource SectionLabel}" />
                <TextBlock Text="Default workspace location" Style="{StaticResource FormLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding DefaultWorkspaceRoot, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="1" Content="Browse..."
                            Style="{StaticResource BaseButton}"
                            Margin="8,0,0,0"
                            Command="{Binding BrowseWorkspaceCommand}" />
                </Grid>
                <Button Content="Clear Recent Projects"
                        Style="{StaticResource BaseButton}"
                        HorizontalAlignment="Left"
                        Margin="0,12,0,0"
                        Command="{Binding ClearRecentsCommand}" />
            </StackPanel>
        </Border>

        <!-- Mode -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="USER MODE" Style="{StaticResource SectionLabel}" />
                <CheckBox Content="Basic Mode (recommended — hides dangerous tools)"
                          IsChecked="{Binding IsBasicMode, Mode=TwoWay}"
                          Command="{Binding ToggleModeCommand}"
                          Margin="0,2" />
                <TextBlock Style="{StaticResource HintText}"
                           Text="Advanced Mode unlocks registry editing, DISM packages, services and custom scripts. Every change is still risk-rated and reviewed before a build." />
            </StackPanel>
        </Border>

        <!-- Appearance (fixed) -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="APPEARANCE" Style="{StaticResource SectionLabel}" />
                <TextBlock Text="The application uses a fixed light theme."
                           Style="{StaticResource HintText}" />
            </StackPanel>
        </Border>

        <!-- About -->
        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="ABOUT" Style="{StaticResource SectionLabel}" />
                <TextBlock Text="{Binding DataRoot}" Style="{StaticResource HintText}" />
                <Button Content="About Windows Customizer Studio"
                        Style="{StaticResource BaseButton}"
                        HorizontalAlignment="Left"
                        Margin="0,10,0,0"
                        Command="{Binding ShowAboutCommand}" />
            </StackPanel>
        </Border>

        <Button Content="Save Settings"
                Style="{StaticResource PrimaryButton}"
                HorizontalAlignment="Left"
                Command="{Binding SaveCommand}" />
    </StackPanel>
</UserControl>
