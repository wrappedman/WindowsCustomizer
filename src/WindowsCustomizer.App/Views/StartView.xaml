<UserControl x:Class="WindowsCustomizer.App.Views.StartView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:svc="clr-namespace:WindowsCustomizer.Core.Services;assembly=WindowsCustomizer.Core">
    <StackPanel>
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
        <!-- Fixed-width subtitle: never reflows/moves when the window is resized -->
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}"
                   HorizontalAlignment="Left" Width="760" />

        <!-- Action cards -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- New Project -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Cursor="Hand" MouseLeftButtonUp="NewProject_Click">
                <StackPanel>
                    <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                               Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="New Project" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,4"
                               Foreground="{DynamicResource Brush.TextPrimary}" />
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Start from a Windows 10 / 11 ISO. The wizard analyzes it and prepares a workspace — the original ISO is never touched." />
                    <Button Content="Create Project"
                            Style="{StaticResource PrimaryButton}"
                            HorizontalAlignment="Left"
                            Margin="0,16,0,0"
                            Command="{Binding NewProjectCommand}" />
                </StackPanel>
            </Border>

            <!-- Open Project -->
            <Border Grid.Column="2" Style="{StaticResource Card}" Cursor="Hand" MouseLeftButtonUp="OpenProject_Click">
                <StackPanel>
                    <TextBlock Text="&#xE838;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                               Foreground="{DynamicResource Brush.Accent}" />
                    <TextBlock Text="Open Existing Project" FontSize="17" FontWeight="SemiBold" Margin="0,12,0,4"
                               Foreground="{DynamicResource Brush.TextPrimary}" />
                    <TextBlock Style="{StaticResource HintText}"
                               Text="Continue working on a saved .wcp project: all customization choices, logs and outputs are restored exactly as you left them." />
                    <Button Content="Open Project"
                            Style="{StaticResource BaseButton}"
                            HorizontalAlignment="Left"
                            Margin="0,16,0,0"
                            Command="{Binding OpenProjectCommand}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Recent projects -->
        <Border Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="RECENT PROJECTS" Style="{StaticResource SectionLabel}" />

                <TextBlock Text="No recent projects yet. Create your first project to see it here."
                           Style="{StaticResource HintText}"
                           Visibility="{Binding HasRecents, Converter={StaticResource NullToVisibility}, ConverterParameter=Invert}" />

                <ItemsControl ItemsSource="{Binding RecentProjects}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type svc:RecentProjectItem}">
                            <Border Background="{DynamicResource Brush.SurfaceAlt}"
                                    CornerRadius="8"
                                    Padding="12,10"
                                    Margin="0,0,0,8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Cursor="Hand" MouseLeftButtonUp="Recent_Click">
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                                        <TextBlock FontSize="11"
                                                   Foreground="{DynamicResource Brush.TextSecondary}"
                                                   TextTrimming="CharacterEllipsis">
                                            <Run Text="{Binding ProjectFile, Mode=OneWay}" />
                                            <Run Text="  ·  " />
                                            <Run Text="{Binding SourceIsoName, Mode=OneWay}" />
                                            <Run Text="  ·  " />
                                            <Run Text="{Binding LastOpenedUtc, StringFormat=yyyy-MM-dd HH:mm, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Open"
                                            Style="{StaticResource BaseButton}"
                                            Padding="12,5"
                                            FontSize="12"
                                            Command="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                    <Button Grid.Column="2"
                                            Content="Remove"
                                            Style="{StaticResource BaseButton}"
                                            Padding="12,5"
                                            FontSize="12"
                                            Margin="8,0,0,0"
                                            Command="{Binding DataContext.RemoveRecentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Footer actions -->
        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
            <Button Content="Settings" Style="{StaticResource BaseButton}" Command="{Binding OpenSettingsCommand}" />
            <Button Content="Documentation / Help" Style="{StaticResource BaseButton}" Margin="10,0,0,0" Command="{Binding OpenHelpCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>
