<UserControl x:Class="WindowsCustomizer.App.Views.FeaturesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="960" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Load Features (DISM)" Style="{StaticResource PrimaryButton}" Command="{Binding LoadFeaturesCommand}" />
            <Button Content="Add Custom" Style="{StaticResource BaseButton}" Margin="10,0,0,0" Command="{Binding AddCustomCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding LoadStatus}" Style="{StaticResource HintText}" Foreground="{DynamicResource Brush.Accent}" Margin="0,-6,0,12" />

        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource HintText}">
                                    <Run Text="{Binding FeatureName, Mode=OneWay}" /> · state: <Run Text="{Binding State, Mode=OneWay}" />
                                    <Run Text=" · deps: " /><Run Text="{Binding Dependencies, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <CheckBox Grid.Column="1" Content="Enable" IsChecked="{Binding Enable, Mode=TwoWay}"
                                      VerticalAlignment="Center" Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                            <CheckBox Grid.Column="2" Content="Remove" IsChecked="{Binding Remove, Mode=TwoWay}"
                                      VerticalAlignment="Center" Margin="8,0,0,0" Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                            <Button Grid.Column="3" Content="✕" Style="{StaticResource BaseButton}" Padding="8,5" FontSize="12" Margin="8,0,0,0"
                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
