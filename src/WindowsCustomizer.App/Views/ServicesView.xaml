<UserControl x:Class="WindowsCustomizer.App.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="960" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Add Service (exe)…" Style="{StaticResource PrimaryButton}" Command="{Binding AddServiceBinaryCommand}" />
            <Button Content="Add Service Files…" Style="{StaticResource BaseButton}" Margin="10,0,0,0" Command="{Binding AddServiceFileCommand}" />
            <Button Content="Add Service Folder…" Style="{StaticResource BaseButton}" Margin="10,0,0,0" Command="{Binding AddServiceFolderCommand}" />
            <Button Content="Delete Service…" Style="{StaticResource DangerButton}" Margin="10,0,0,0" Command="{Binding DeleteServiceCommand}" />
        </StackPanel>

        <Border Background="#33FFC83D" CornerRadius="8" Padding="12,8" Margin="0,0,0,12"
                Visibility="{Binding Warning, Converter={StaticResource NullToVisibility}}">
            <TextBlock Text="{Binding Warning}" Foreground="{DynamicResource Brush.Warning}" TextWrapping="Wrap" FontSize="12.5" />
        </Border>

        <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,10" TextWrapping="Wrap"
                   Text="Use 'Add Service (exe)…' to create your own service (its file is copied into the image). Use 'Add Service Files/Folder…' when a service needs extra files on the target Windows. 'Delete Service…' removes an unwanted service entirely." />

        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="200" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <Border Background="#33FF6B6B" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                            Visibility="{Binding IsCritical, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Critical" FontSize="10" Foreground="{DynamicResource Brush.Error}" />
                                    </Border>
                                    <Border Background="#33B0C4DE" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                            Visibility="{Binding Action, Converter={StaticResource ActionToVisibility}}">
                                        <TextBlock Text="{Binding Action}" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap">
                                    <Run Text="{Binding ServiceName, Mode=OneWay}" />
                                    <Run Text=" — " /><Run Text="{Binding Description, Mode=OneWay}" />
                                </TextBlock>
                                <TextBlock Style="{StaticResource HintText}" TextWrapping="Wrap"
                                           Visibility="{Binding Warning, Converter={StaticResource NullToVisibility}}"
                                           Text="{Binding Warning}" />
                            </StackPanel>
                            <ComboBox Grid.Column="2"
                                      ItemsSource="{Binding DataContext.StartupTypes, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                      SelectedItem="{Binding Startup, Mode=TwoWay}"
                                      SelectionChanged="ServiceStartup_Changed"
                                      VerticalAlignment="Center" />
                            <Button Grid.Column="3" Content="✕" Style="{StaticResource BaseButton}" Padding="8,5" FontSize="12"
                                    VerticalAlignment="Center" Margin="8,0,0,0"
                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
