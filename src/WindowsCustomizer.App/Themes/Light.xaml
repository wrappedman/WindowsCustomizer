<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light theme palette -->
    <SolidColorBrush x:Key="Brush.AppBackground" Color="#F3F3F6" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#ECECF0" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="#EDEDF1" />
    <SolidColorBrush x:Key="Brush.Accent" Color="#0067C0" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#0078D4" />
    <SolidColorBrush x:Key="Brush.AccentSoft" Color="#D5E8F7" />
    <SolidColorBrush x:Key="Brush.NavSelected" Color="#D9E9F6" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#1B1B1F" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#5C6269" />
    <SolidColorBrush x:Key="Brush.TextDisabled" Color="#9AA0A6" />
    <SolidColorBrush x:Key="Brush.Border" Color="#D6D6DC" />
    <SolidColorBrush x:Key="Brush.InputBackground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Hover" Color="#E2E2E8" />
    <SolidColorBrush x:Key="Brush.Success" Color="#2E7D32" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#B26A00" />
    <SolidColorBrush x:Key="Brush.Error" Color="#C62828" />
    <SolidColorBrush x:Key="Brush.LogBackground" Color="#FAFAFC" />

    <Color x:Key="Color.Accent">#0067C0</Color>
</ResourceDictionary>
