<UserControl x:Class="WindowsCustomizer.App.Views.EditionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="TARGET EDITION" Style="{StaticResource SectionLabel}" />
                <CheckBox Content="Apply changes to multiple editions (Multiple Images mode)"
                          IsChecked="{Binding IsMultiple, Mode=TwoWay}" Margin="0,0,0,10" />
                <StackPanel Orientation="Horizontal">
                    <Button Content="Load Images from WIM (DISM)" Style="{StaticResource PrimaryButton}"
                            Command="{Binding LoadImagesCommand}" />
                    <Button Content="Select Edition" Style="{StaticResource BaseButton}" Margin="10,0,0,0"
                            Command="{Binding SelectImageCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding LoadStatus}" Style="{StaticResource HintText}"
                           Foreground="{DynamicResource Brush.Accent}" />
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <StackPanel>
                <TextBlock Text="WINDOWS IMAGES" Style="{StaticResource SectionLabel}" />
                <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,10" TextWrapping="Wrap"
                           Visibility="{Binding Images.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}"
                           Text="No editions loaded yet — the list fills in automatically (the first run extracts install.wim from the ISO and can take a few minutes). If it stays empty, check the ISO on the 'Source ISO' page and press 'Load Images' again." />
                <ListView ItemsSource="{Binding Images}" SelectedItem="{Binding SelectedImage}" MaxHeight="360"
                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Index" Width="60" DisplayMemberBinding="{Binding Index}" />
                            <GridViewColumn Header="Name" Width="280" DisplayMemberBinding="{Binding Name}" />
                            <GridViewColumn Header="Description" Width="280" DisplayMemberBinding="{Binding Description}" />
                            <GridViewColumn Header="Size" Width="120" DisplayMemberBinding="{Binding SizeBytes}" />
                        </GridView>
                    </ListView.View>
                </ListView>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
