<Application x:Class="WindowsCustomizer.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WindowsCustomizer.App.ViewModels"
             xmlns:views="clr-namespace:WindowsCustomizer.App.Views"
             xmlns:conv="clr-namespace:WindowsCustomizer.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Single light theme: dark theme has been removed by design. -->
                <ResourceDictionary Source="Themes/Light.xaml" />
                <ResourceDictionary Source="Themes/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
            <conv:NullOrEmptyToVisibilityConverter x:Key="NullToVisibility" />
            <conv:CountToVisibilityConverter x:Key="CountToVisibility" />
            <conv:ServiceActionToVisibilityConverter x:Key="ActionToVisibility" />
            <conv:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
            <conv:InverseBooleanConverter x:Key="InverseBool" />

            <!-- ViewModels map 1:1 onto views; MainViewModel swaps CurrentViewModel. -->
            <DataTemplate DataType="{x:Type vm:StartViewModel}">
                <views:StartView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:NewProjectViewModel}">
                <views:NewProjectView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:IsoAnalysisViewModel}">
                <views:IsoAnalysisView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UsersViewModel}">
                <views:UsersView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AppsViewModel}">
                <views:AppsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:DriversViewModel}">
                <views:DriversView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:UpdatesViewModel}">
                <views:UpdatesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:RegistryViewModel}">
                <views:RegistryView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ServicesViewModel}">
                <views:ServicesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:FeaturesViewModel}">
                <views:FeaturesView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ScriptsViewModel}">
                <views:ScriptsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BrandingViewModel}">
                <views:BrandingView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:ReviewViewModel}">
                <views:ReviewView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:BuildViewModel}">
                <views:BuildView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
                <views:SettingsView />
            </DataTemplate>
            <DataTemplate DataType="{x:Type vm:AboutViewModel}">
                <views:AboutView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
