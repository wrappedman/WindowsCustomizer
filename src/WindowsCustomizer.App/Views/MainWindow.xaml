<Window x:Class="WindowsCustomizer.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WindowsCustomizer.App.ViewModels"
        Title="Windows Customizer Studio"
        Width="1280" Height="820"
        MinWidth="1024" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.AppBackground}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:NavItemViewModel}">
            <RadioButton Style="{StaticResource NavItem}"
                         GroupName="MainNav"
                         IsChecked="{Binding IsSelected, Mode=TwoWay}"
                         IsEnabled="{Binding IsAvailable}"
                         ToolTip="{Binding ToolTip}"
                         Click="NavButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding Glyph}"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Width="24"
                               VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Title}"
                               FontSize="13"
                               VerticalAlignment="Center" />
                </StackPanel>
            </RadioButton>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="248" MinWidth="190" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Draggable splitter: sidebar/content panel widths are adjustable -->
        <GridSplitter Grid.Row="0" Grid.Column="1"
                      Width="5" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="PreviousAndCurrent"
                      ResizeDirection="Columns" Cursor="SizeWE" />

        <!-- ============ Sidebar ============ -->
        <Border Grid.Row="0" Grid.Column="0"
                Background="{DynamicResource Brush.Sidebar}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <!-- Brand -->
                <StackPanel DockPanel.Dock="Top" Margin="18,20,18,6">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="22"
                                   Foreground="{DynamicResource Brush.Accent}" VerticalAlignment="Center" />
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Windows Customizer" FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextPrimary}" VerticalAlignment="Center" />
                                <Border Background="#223B82F6" CornerRadius="4" Padding="6,2" Margin="8,0,0,0"
                                        VerticalAlignment="Center"
                                        ToolTip="Servicing operations (DISM/registry) are performed with administrator rights.">
                                    <TextBlock Text="{Binding AdminStatusText}" FontSize="10"
                                               Foreground="{DynamicResource Brush.Accent}" />
                                </Border>
                            </StackPanel>
                            <TextBlock Text="Studio v1.0" FontSize="10.5"
                                       Foreground="{DynamicResource Brush.TextSecondary}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Navigation sections (last child = fills the sidebar) -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,4,0,12">
                    <ItemsControl ItemsSource="{Binding Navigation}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Section}"
                                               Style="{StaticResource NavGroupLabel}"
                                               Visibility="{Binding Section, Converter={StaticResource NullToVisibility}}" />
                                    <ItemsControl ItemsSource="{Binding Items}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:NavItemViewModel}">
                                                <RadioButton Style="{StaticResource NavItem}"
                                                             GroupName="MainNav"
                                                             IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                             IsEnabled="{Binding IsAvailable}"
                                                             ToolTip="{Binding ToolTip}"
                                                             Click="NavButton_Click">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Glyph}"
                                                                   FontFamily="Segoe MDL2 Assets"
                                                                   FontSize="14"
                                                                   Width="24"
                                                                   VerticalAlignment="Center" />
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontSize="13"
                                                                   VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </RadioButton>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ============ Content ============ -->
        <Grid Grid.Row="0" Grid.Column="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto">
                <ContentControl Content="{Binding CurrentViewModel}"
                                Margin="28,22,28,28"
                                Focusable="False" />
            </ScrollViewer>

            <!-- Log panel overlay -->
            <Border VerticalAlignment="Bottom"
                    Height="220"
                    Margin="16,0,16,12"
                    Background="{DynamicResource Brush.LogBackground}"
                    BorderBrush="{DynamicResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Visibility="{Binding IsLogPanelOpen, Converter={StaticResource BoolToVisibility}}">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="12,8,12,4">
                        <TextBlock Text="Operation Log"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                        <Button Content="Close"
                                Style="{StaticResource BaseButton}"
                                HorizontalAlignment="Right"
                                Padding="10,3"
                                FontSize="11"
                                Command="{Binding CloseLogPanelCommand}" />
                    </Grid>
                    <TextBlock DockPanel.Dock="Bottom"
                               Margin="12,2,12,8"
                               FontSize="10.5"
                               Foreground="{DynamicResource Brush.TextSecondary}"
                               Text="{Binding LogFilePath}" />
                    <ListBox ItemsSource="{Binding LogEntries}"
                             ScrollViewer.HorizontalScrollBarVisibility="Auto"
                             Margin="8,4">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding Timestamp, StringFormat=HH:mm:ss}"
                                               Foreground="{DynamicResource Brush.TextSecondary}"
                                               Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Severity}" FontSize="11" Margin="0,0,8,0">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Warning">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Error">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Severity}" Value="Success">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="{Binding Operation}" FontWeight="SemiBold" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding Message}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>
        </Grid>

        <!-- ============ Status bar ============ -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Background="{DynamicResource Brush.Sidebar}"
                BorderBrush="{DynamicResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="14,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding StatusText}"
                           FontSize="11.5"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis"
                           MaxWidth="560" />

                <ProgressBar Grid.Column="2"
                             Style="{StaticResource ModernProgress}"
                             Value="{Binding ProgressValue}"
                             Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisibility}}"
                             VerticalAlignment="Center" />

                <Button Grid.Column="3"
                        Style="{StaticResource BaseButton}"
                        Padding="10,3"
                        FontSize="11"
                        Margin="8,0"
                        Command="{Binding ToggleLogPanelCommand}"
                        Content="{Binding LogToggleText}" />

                <TextBlock Grid.Column="4"
                           Text="{Binding VersionText}"
                           FontSize="11"
                           Foreground="{DynamicResource Brush.TextDisabled}"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>
