<UserControl x:Class="WindowsCustomizer.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="1060" HorizontalAlignment="Left">

        <!-- ============ Hero ============ -->
        <Border CornerRadius="14" Padding="26,22" Margin="0,0,0,20"
                Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="76" Height="76" CornerRadius="18"
                        Background="#1A3B82F6" VerticalAlignment="Top">
                    <Grid>
                        <TextBlock Text="&#xE790;" FontFamily="Segoe MDL2 Assets" FontSize="38"
                                   Foreground="{DynamicResource Brush.Accent}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Image x:Name="HeroIcon" Width="56" Height="56"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                </Border>
                <StackPanel Grid.Column="1" Margin="20,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Windows Customizer Studio" FontSize="26" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                        <Border Background="#223B82F6" CornerRadius="6" Padding="9,4" Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Version}" FontSize="11.5"
                                       Foreground="{DynamicResource Brush.Accent}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding Subtitle}" FontSize="13.5" TextWrapping="Wrap"
                               Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ Capabilities grid ============ -->
        <TextBlock Text="WHAT THIS PROGRAM DOES" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />
        <ItemsControl ItemsSource="{Binding Features}" Margin="0,0,0,22">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Width="500" CornerRadius="12" Padding="16,14" Margin="0,0,14,14"
                            Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Width="42" Height="42" CornerRadius="10"
                                    Background="#143B82F6" VerticalAlignment="Top">
                                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="19"
                                           Foreground="{DynamicResource Brush.Accent}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                <TextBlock Text="{Binding Title}" FontSize="14.5" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.TextPrimary}" />
                                <TextBlock Text="{Binding Description}" FontSize="11.8" TextWrapping="Wrap"
                                           Foreground="{DynamicResource Brush.TextSecondary}" Margin="0,5,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ============ Pipeline chips ============ -->
        <TextBlock Text="THE BUILD PIPELINE" Style="{StaticResource SectionLabel}" Margin="0,0,0,10" />
        <ItemsControl ItemsSource="{Binding Pipeline}" Margin="0,0,0,22">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border CornerRadius="20" Padding="13,6" Margin="0,0,8,8"
                            Background="#143B82F6" BorderBrush="#333B82F6" BorderThickness="1">
                        <TextBlock FontSize="11.5" Foreground="{DynamicResource Brush.Accent}">
                            <Run Text="{Binding Mode=OneWay}" />
                        </TextBlock>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ============ How it works ============ -->
        <Border CornerRadius="12" Padding="20,16" Margin="0,0,0,16"
                Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="HOW IT WORKS" Style="{StaticResource SectionLabel}" Margin="0,0,0,8" />
                <TextBlock Text="{Binding HowItWorks}" TextWrapping="Wrap" FontSize="12.5"
                           Foreground="{DynamicResource Brush.TextPrimary}" />
                <Border Background="#14FFC83D" CornerRadius="8" Padding="12,9" Margin="0,12,0,0">
                    <TextBlock Text="{Binding RuntimeNotes}" TextWrapping="Wrap" FontSize="11.5"
                               Foreground="#8A6A00" />
                </Border>
            </StackPanel>
        </Border>

        <!-- ============ Author & contact ============ -->
        <Border CornerRadius="12" Padding="20,16" Margin="0,0,0,16"
                Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="AUTHOR &amp; CONTACT" Style="{StaticResource SectionLabel}" Margin="0,0,0,12" />
                <ItemsControl ItemsSource="{Binding Contacts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8"
                                        Background="#143B82F6">
                                    <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15"
                                               Foreground="{DynamicResource Brush.Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontWeight="SemiBold"
                                           FontSize="12.5" VerticalAlignment="Center" Margin="12,0,0,0"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                <TextBlock Grid.Column="2" Text="{Binding Value}" FontSize="13"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource Brush.TextPrimary}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- ============ Footer ============ -->
        <TextBlock Text="{Binding Copyright}" FontSize="11.5" HorizontalAlignment="Left"
                   Foreground="{DynamicResource Brush.TextSecondary}" Margin="4,2,0,10" />
    </StackPanel>
</UserControl>
