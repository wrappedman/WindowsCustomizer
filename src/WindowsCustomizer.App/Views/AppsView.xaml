<UserControl x:Class="WindowsCustomizer.App.Views.AppsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="960" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Load Apps from Image (DISM)" Style="{StaticResource PrimaryButton}" Command="{Binding LoadAppsCommand}" />
            <Button Content="Add App Package (file)…" Style="{StaticResource BaseButton}" Margin="10,0,0,0" Command="{Binding AddAppPackageCommand}" />
            <Button Content="Add Provisioned (by name)…" Style="{StaticResource BaseButton}" Margin="10,0,0,0" Command="{Binding AddCustomCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding LoadStatus}" Style="{StaticResource HintText}" Foreground="{DynamicResource Brush.Accent}"
                   TextWrapping="Wrap" Margin="0,-6,0,12" />

        <!-- Applications to install (MSIX/AppX are provisioned; EXE/MSI install at first boot) -->
        <TextBlock Text="APPLICATIONS TO INSTALL" Style="{StaticResource SectionLabel}" />
        <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8"
                   Text="AppX/MSIX packages are provisioned into the image; EXE/MSI installers run silently at first boot. Silent arguments are editable." />
        <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,10"
                   Visibility="{Binding InstallApps.Count, Converter={StaticResource CountToVisibility}, ConverterParameter=Invert}"
                   Text="No applications to install yet — use 'Add App Package (file)…' and pick the .appx/.msix/.exe/.msi from disk." />
        <ItemsControl ItemsSource="{Binding InstallApps}" Margin="0,0,0,16">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="220" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource HintText}" TextTrimming="CharacterEllipsis">
                                    <Run Text="{Binding InstallerPath, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0">
                                <TextBlock Text="Silent arguments" FontSize="10" Foreground="{DynamicResource Brush.TextSecondary}" />
                                <TextBox Text="{Binding SilentArguments, UpdateSourceTrigger=PropertyChanged}" FontSize="12" Padding="6,4" />
                            </StackPanel>
                            <Button Grid.Column="2" Content="✕" Style="{StaticResource BaseButton}" Padding="8,5" FontSize="12"
                                    VerticalAlignment="Center"
                                    Command="{Binding DataContext.RemoveAppPackageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Provisioned apps: Keep / Remove / Optional -->
        <TextBlock Text="PROVISIONED APPS (REMOVE / KEEP)" Style="{StaticResource SectionLabel}" />
        <TextBlock Style="{StaticResource HintText}" Margin="0,0,0,8"
                   Text="Choose Keep (default), Remove or Optional for each pre-installed app. Red-flagged packages may break Windows — a confirmation is required to remove them." />
        <ItemsControl ItemsSource="{Binding Apps}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                    <Border Background="#33FF8A8A" CornerRadius="4" Padding="6,1" Margin="8,0,0,0"
                                            Visibility="{Binding IsSensitive, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="Sensitive" FontSize="10" Foreground="#5A3E00" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Style="{StaticResource HintText}">
                                    <Run Text="{Binding PackageName, Mode=OneWay}" /> · <Run Text="{Binding Description, Mode=OneWay}" /> — current: <Run Text="{Binding Mode, Mode=OneWay}" />
                                </TextBlock>
                            </StackPanel>
                            <Button Grid.Column="1" Content="Keep" Style="{StaticResource BaseButton}" Padding="10,5" FontSize="12"
                                    Command="{Binding DataContext.SetKeepCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                            <Button Grid.Column="2" Content="Remove" Style="{StaticResource DangerButton}" Padding="10,5" FontSize="12" Margin="6,0,0,0"
                                    Command="{Binding DataContext.SetRemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                            <Button Grid.Column="3" Content="Optional" Style="{StaticResource BaseButton}" Padding="10,5" FontSize="12" Margin="6,0,0,0"
                                    Command="{Binding DataContext.SetOptionalCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                            <Button Grid.Column="4" Content="✕" Style="{StaticResource BaseButton}" Padding="8,5" FontSize="12" Margin="6,0,0,0"
                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
