<UserControl x:Class="WindowsCustomizer.App.Views.DriversView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="960" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />

        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Add INF Driver" Style="{StaticResource PrimaryButton}" Command="{Binding AddInfCommand}" />
            <Button Content="Add Driver Folder" Style="{StaticResource BaseButton}" Margin="10,0,0,0" Command="{Binding AddFolderCommand}" />
            <Button Content="Export List" Style="{StaticResource BaseButton}" Margin="10,0,0,0" Command="{Binding ExportListCommand}" />
        </StackPanel>
        <TextBlock Text="{Binding AddStatus}" Style="{StaticResource HintText}" Foreground="{DynamicResource Brush.Accent}" Margin="0,-6,0,12" />

        <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Background="{DynamicResource Brush.Surface}" BorderBrush="{DynamicResource Brush.Border}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,0,0,8">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                                <TextBlock Style="{StaticResource HintText}" Text="{Binding SourcePath}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Button Grid.Column="1" Content="Remove" Style="{StaticResource DangerButton}" Padding="12,5" FontSize="12"
                                    Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
