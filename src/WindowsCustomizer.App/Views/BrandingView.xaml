<UserControl x:Class="WindowsCustomizer.App.Views.BrandingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="IMAGES" Style="{StaticResource SectionLabel}" />
                <TextBlock Text="Wallpaper" Style="{StaticResource FormLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding B.WallpaperPath}" IsReadOnly="True" />
                    <Button Grid.Column="1" Content="Browse..." Style="{StaticResource BaseButton}" Margin="8,0,0,0"
                            Command="{Binding PickWallpaperCommand}" />
                </Grid>
                <TextBlock Text="Lock screen image" Style="{StaticResource FormLabel}" Margin="0,12,0,5" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding B.LockScreenPath}" IsReadOnly="True" />
                    <Button Grid.Column="1" Content="Browse..." Style="{StaticResource BaseButton}" Margin="8,0,0,0"
                            Command="{Binding PickLockScreenCommand}" />
                </Grid>
                <TextBlock Text="Company logo" Style="{StaticResource FormLabel}" Margin="0,12,0,5" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox Grid.Column="0" Text="{Binding B.LogoPath}" IsReadOnly="True" />
                    <Button Grid.Column="1" Content="Browse..." Style="{StaticResource BaseButton}" Margin="8,0,0,0"
                            Command="{Binding PickLogoCommand}" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="OEM INFORMATION" Style="{StaticResource SectionLabel}" />
                <TextBlock Text="Manufacturer" Style="{StaticResource FormLabel}" />
                <TextBox Text="{Binding B.Manufacturer, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Model" Style="{StaticResource FormLabel}" Margin="0,12,0,5" />
                <TextBox Text="{Binding B.Model, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Support URL" Style="{StaticResource FormLabel}" Margin="0,12,0,5" />
                <TextBox Text="{Binding B.SupportUrl, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="Support phone" Style="{StaticResource FormLabel}" Margin="0,12,0,5" />
                <TextBox Text="{Binding B.SupportPhone, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>
        </Border>

        <Button Content="Save Branding" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left"
                Command="{Binding SaveBrandingCommand}" />
    </StackPanel>
</UserControl>
