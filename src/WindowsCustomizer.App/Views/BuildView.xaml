<UserControl x:Class="WindowsCustomizer.App.Views.BuildView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MaxWidth="1000" HorizontalAlignment="Left">
        <TextBlock Text="{Binding Title}" Style="{StaticResource PageTitle}" />
        <TextBlock Text="{Binding Subtitle}" Style="{StaticResource PageSubtitle}" />

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="DISK SPACE ESTIMATE" Style="{StaticResource SectionLabel}" />
                <TextBlock Text="{Binding SpaceEstimate}" Style="{StaticResource HintText}" FontFamily="Consolas" />
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
            <Button Content="Build Customized ISO" Style="{StaticResource PrimaryButton}" Command="{Binding BuildCommand}" />
            <Button Content="Cancel" Style="{StaticResource BaseButton}" Margin="10,0,0,0" Command="{Binding CancelCommand}" />
            <Button Content="Validate Output" Style="{StaticResource BaseButton}" Margin="10,0,0,0" Command="{Binding ValidateOutputCommand}" />
            <Button Content="Open Output Folder" Style="{StaticResource BaseButton}" Margin="10,0,0,0" Command="{Binding OpenOutputFolderCommand}" />
            <Button Content="Test in VM" Style="{StaticResource BaseButton}" Margin="10,0,0,0" Command="{Binding TestInVmCommand}" />
        </StackPanel>

        <TextBlock Text="{Binding CurrentStep}" Foreground="{DynamicResource Brush.Accent}" FontSize="13" Margin="0,4,0,8" />
        <ProgressBar Style="{StaticResource ModernProgress}" Value="{Binding ProgressValue}" Margin="0,0,0,12" />

        <Border Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="PIPELINE STEPS" Style="{StaticResource SectionLabel}" />
                <ItemsControl ItemsSource="{Binding Steps}" MaxHeight="240">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="220" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Success}" Width="44" Margin="0,0,12,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Success}" Value="False">
                                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Error}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="2" Text="{Binding Duration, StringFormat={}{0:mm\\:ss}}" Margin="8,0"
                                           Foreground="{DynamicResource Brush.TextSecondary}" />
                                <TextBlock Grid.Column="3" Text="{Binding Detail}" Style="{StaticResource HintText}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="BUILD REPORT" Style="{StaticResource SectionLabel}" />
                <TextBox Text="{Binding ReportSummary}" IsReadOnly="True" TextWrapping="Wrap"
                         FontFamily="Consolas" FontSize="11.5" MaxHeight="360"
                         VerticalScrollBarVisibility="Auto"
                         Background="{DynamicResource Brush.LogBackground}" />
            </DockPanel>
        </Border>
    </StackPanel>
</UserControl>
